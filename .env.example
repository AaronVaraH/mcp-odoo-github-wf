# Odoo Server Configuration
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=tu_base_de_datos

# Authentication: You can provide ODOO_UID directly OR your ODOO_USER to authenticate dynamically
ODOO_UID=123
# ODOO_USER=usuario@empresa.com

# API Key or Password (recommended: API key generated from User Profile -> Account Security)
ODOO_API_KEY=tu_odoo_api_key_o_password
